# macOS
.DS_Store
**/.DS_Store

# Node / Next.js (website/)
website/node_modules/
website/.next/
website/out/
website/.vercel/
website/*.tsbuildinfo
website/next-env.d.ts
website/npm-debug.log*
website/yarn-debug.log*
website/yarn-error.log*
website/.pnpm-debug.log*
website/coverage/

# env files — never committed, even if one shows up later
**/.env*
!**/.env.example
photos/

# local working/reference material, not site source — lives at repo root,
# not under website/, so keep it off git entirely (large, non-code, personal)
/brand-assets/
# /branding/ is NOT ignored wholesale any more. It holds the actual brand
# deliverables -- the outlined logo artwork, the packaging plan, the voice
# notes -- which is 664K of SVG, PNG and Markdown and exactly the sort of thing
# that must not live on one laptop. brand-assets/ stays out: it is 252MB of
# working material. Anything else dropped into branding/ stays ignored, so the
# folder can still be used as scratch.
# ⚠️ THESE EXCEPTIONS ARE NAMED FOLDERS, SO RENAMING ONE SILENTLY UNTRACKS IT.
# That already happened once: logo/ was split into the three folders below and
# 47 artwork files went back to being ignored, on disk only, while a commit
# that looked successful removed the old ones. If a folder here is ever
# renamed, change it here in the same commit and check `git ls-files branding/`.
/branding/*
!/branding/send-to-supplier/
!/branding/other-formats/
!/branding/source/
!/branding/pages/
!/branding/*.md
/insparation/

# legal/incorporation documents — reference copies only, not for version control
/DCCI-*.pdf
/LicenseCertificateReport_*.pdf

# Generated tech packs / spec sheets downloaded from the dashboard. The
# filename carries an order id, and the document carries that customer's
# MEASUREMENTS -- these must never reach git. Kept on disk, ignored by version
# control, same reasoning as the PII rule in CLAUDE.md section 0.

# Compiled output of website/scripts/social/encode.swift. A build artifact and
# a Mach-O binary; rebuild it from the .swift source rather than committing it.
website/scripts/social/encode

# _archive/ is committed on purpose -- it is where superseded work goes so it
# is never lost. Two things inside it must still stay out of git:
#   - screenshots: 31MB of local screenshots, no value in history
#   - downloaded tech packs: the filename carries an order id and the document
#     carries that CUSTOMER'S MEASUREMENTS. Same PII rule as CLAUDE.md §0.
/_archive/screenshots-2026-08-15/
/_archive/downloaded-tech-packs/
# 100 byte-identical duplicates of catalog .jpg files, moved out of
# website/public/ on 2026-08-27. Kept rather than deleted per CLAUDE.md, but
# ignored: git already holds every one of them under its .jpg name.
/_archive/duplicate-png-names/

# Generated supplier hand-off folder, rebuilt by build-final-folder.mjs
/send-to-packagin-supplier-final/
