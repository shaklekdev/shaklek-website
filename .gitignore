# macOS
.DS_Store
**/.DS_Store

# Node / Next.js (website/)
website/node_modules/
website/.next/
website/out/
website/.vercel/
website/*.tsbuildinfo
website/next-env.d.ts
website/npm-debug.log*
website/yarn-debug.log*
website/yarn-error.log*
website/.pnpm-debug.log*
website/coverage/

# env files — never committed, even if one shows up later
**/.env*
!**/.env.example
photos/

# local working/reference material, not site source — lives at repo root,
# not under website/, so keep it off git entirely (large, non-code, personal)
/brand-assets/
/branding/
/insparation/
/top/
/shaklek_logo_*.html

# legal/incorporation documents — reference copies only, not for version control
/DCCI-*.pdf
/LicenseCertificateReport_*.pdf

# Generated tech packs / spec sheets downloaded from the dashboard. The
# filename carries an order id, and the document carries that customer's
# MEASUREMENTS -- these must never reach git. Kept on disk, ignored by version
# control, same reasoning as the PII rule in CLAUDE.md section 0.
/shaklek-spec-*.pdf

# Compiled output of website/scripts/social/encode.swift. A build artifact and
# a Mach-O binary; rebuild it from the .swift source rather than committing it.
website/scripts/social/encode
